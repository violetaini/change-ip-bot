telegram_bot_token: ""
telegram_chat_id: ""
# 可选：单独限制允许操作机器人的 Telegram 用户ID，留空时兼容旧逻辑：
# 私聊按 telegram_chat_id 授权；群聊按 telegram_chat_id 中的群 chat_id 授权。
telegram_allowed_user_ids: ""
# 超级管理员可以执行敏感操作；普通管理员可以执行 /change 和只读检测命令。
telegram_super_admin_user_ids: ""
telegram_admin_user_ids: ""

# 状态文件路径，可用环境变量 VPS_IP_BOT_STATE_FILE 覆盖
state_file: "/var/lib/vps-ip-bot/state.json"

# IP检查配置
ip_check_cmd: "curl -s api-ipv4.ip.sb/ip"
ip_check_api: ""
ip_check_timeout: 60

# IP更换模式配置:
#   - generic: 通用模式 (推荐。请求 API 触发后，通过 curl -4 ip.sb 轮询自动获取新 IP)
#   - fachost: Fachost 专用模式 (解析响应 JSON 中 status: "IP changed" 及 new_ip)
#   - boil: Boil Network 模式 (官方住宅云端 API，自带配额与冷却)
#   - classic: 兼容别名 (等同于 fachost)
ip_change_provider: "generic"

# 通用 / Fachost 模式配置
ip_change_api: ""
ip_change_interval: 2
ip_change_timeout: 600
ip_change_poll_retries: 18 # generic 模式轮询探测次数（默认 18 次）
ip_change_poll_delay: 5    # generic 模式轮询间隔秒数（默认 5 秒，共 90 秒）
ip_change_verify_public_ip: true # fachost 模式校验公网出口

# Boil Network 配置
boil_api_base_url: "https://ippanel.boil.network"
boil_api_token: ""

# 自动换IP配置
auto_change_enabled: false
auto_change_time: "04:00"
auto_change_retry_count: 5
auto_change_retry_delay_seconds: 60
auto_change_notify: true
auto_change_quality_report: true

# DNS生效校验配置。自动换IP成功并发出完成通知后，再等待并检查域名是否解析到新IP。
dns_verify_enabled: true
dns_verify_delay_seconds: 60
dns_verify_retry_count: 10

# 统一DNS更新配置。
# 支持 dns_provider: cloudflare, aliyun, dnspod, tencent_dnspod, godaddy, porkbun, digitalocean, huawei
dns_update_enabled: false
dns_provider: ""
dns_zone_name: ""
dns_record_name: ""
dns_record_type: "A"
dns_ttl: 60

# Cloudflare
cloudflare_api_token: ""
cloudflare_proxied: false

# 阿里云DNS
aliyun_access_key_id: ""
aliyun_access_key_secret: ""

# DNSPod / 腾讯云DNSPod。格式通常为 "ID,Token"
dnspod_login_token: ""

# GoDaddy
godaddy_api_key: ""
godaddy_api_secret: ""

# Porkbun
porkbun_api_key: ""
porkbun_secret_api_key: ""

# DigitalOcean
digitalocean_token: ""

# 华为云DNS配置（使用 AK/SK）。旧配置仍兼容；也可设置 dns_provider: "huawei"。
huawei_dns_enabled: false
huawei_ak: ""
huawei_sk: ""
huawei_dns_zone_name: ""
huawei_dns_record_name: ""
huawei_dns_record_type: "A"
huawei_dns_ttl: 60

# Ping配置
ping_target: "1.1.1.1"
ping_target_v6: "2606:4700:4700::1111"
ping_count: 10

# IP质量检测配置
ip_quality_enabled: true
ip_quality_cmd: "bash <(curl -sL https://IP.Check.Place) -y"

# 流媒体解锁检测配置
stream_check_enabled: true
stream_check_cmd: "bash <(curl -L -s https://github.com/1-stream/RegionRestrictionCheck/raw/main/check.sh)"
# 脚本交互自动输入选项（2=跨国+香港, 1=跨国+台湾, 3=日本, 4=北美, 0=仅跨国, 10=AI平台）
stream_check_input: "2"
stream_check_timeout: 1200

# 远程家宽机器 SSH 配置（开启后 quality、stream、speedtest、ping 将通过 SSH 在家宽机上运行）
remote_ssh_enabled: false
remote_ssh_host: "hkt.example.com"
remote_ssh_port: 22
remote_ssh_user: "root"
remote_ssh_key_path: "/opt/vps-change-ip/ssh_key.pem"
remote_ssh_password: ""
remote_ssh_timeout: 300

# ==============================================================================
# 多服务器管理配置 (Multi-Server Management)
# ==============================================================================
# 如果您有多台服务器/节点需要同时管理（如香港HKT、东京机房、内网住宅等），
# 可在此配置 servers 列表。配置后机器人将支持：
# 1. /servers 查看所有节点看板与状态
# 2. /use <节点ID> 切换当前默认操作节点
# 3. /check [节点ID/all]、/change [节点ID/all] 指定节点或并行批量执行
# 4. /quality [节点ID]、/stream [节点ID]、/ping [节点ID]、/speedtest [节点ID]
# 5. 各节点独立的换IP锁（互不阻塞）、独立DNS同步、独立定时任务
#
# 注意事项：
# - 每个节点必须拥有唯一的 id（字母/数字/下划线）
# - 节点未填写的配置项将自动继承上方的全局配置（例如 telegram_chat_id、dns_provider 等）
# - 若不配置 servers 或留空，系统自动保持单服务器向后兼容运行，无需修改原有配置。
#
# servers:
#   - id: "hkt"
#     name: "香港 HKT 家宽"
#     ip_change_provider: "generic"
#     ip_change_api: "http://192.168.1.100:8080/change-ip" # 支持内网或公网地址
#     remote_ssh_enabled: true
#     remote_ssh_host: "hkt.example.com"
#     remote_ssh_port: 22
#     remote_ssh_user: "root"
#     remote_ssh_key_path: "/opt/vps-change-ip/hkt_ssh.key"
#     dns_update_enabled: true
#     dns_provider: "cloudflare"
#     dns_record_name: "hkt.example.com"
#     dns_zone_name: "example.com"
#     auto_change_enabled: true
#     auto_change_time: "04:00"
#
#   - id: "tokyo"
#     name: "东京 VPS 节点"
#     ip_change_provider: "generic"
#     ip_change_api: "https://api.tokyo-vps.com/change"
#     remote_ssh_enabled: false
#     dns_update_enabled: true
#     dns_provider: "cloudflare"
#     dns_record_name: "tokyo.example.com"
#     dns_zone_name: "example.com"
#     auto_change_enabled: true
#     auto_change_time: "04:30"
#
#   - id: "boil_us"
#     name: "美国 Boil 住宅节点"
#     ip_change_provider: "boil"
#     boil_api_base_url: "https://ippanel.boil.network"
#     boil_api_token: "your_boil_api_token_here"
#     remote_ssh_enabled: false
#     dns_update_enabled: false
#     auto_change_enabled: false


